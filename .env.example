# Copy to .env and fill in secrets before starting the stack. Never commit .env.

# ── Application ────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=12
MAX_DEVICES=10
SECURE_COOKIES=true
DEMO_MODE=false

# ── API server port (used by Docker Compose) ───────────────────────────────────
API_PORT=8000

# ── Database ────────────────────────────────────────────────────────────────────
# For Docker Compose the DATABASE_URL is set automatically from POSTGRES_PASSWORD.
# Override only for native (non-Docker) local development with SQLite:
# DATABASE_URL=sqlite:///./telemetry.db

# Required by Docker Compose. Generate a strong random value before starting.
POSTGRES_PASSWORD=

# ── MQTT broker ────────────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=collector
MQTT_PASSWORD=
MQTT_CLIENT_ID=telemetry-hub-collector
MQTT_TLS=false
# Optional custom CA; leave empty to use the operating system trust store.
MQTT_CA_FILE=

# ── Device health (systemTemp) ─────────────────────────────────────────────────
# Inclusive healthy range. Readings outside [MIN, MAX] are flagged "Not OK".
# Leave blank to show "Unknown" health until thresholds are decided.
SYSTEM_TEMP_MIN=
SYSTEM_TEMP_MAX=
SYSTEM_TEMP_UNIT=

# ══════════════════════════════════════════════════════════════════════════════
# ColdChain extensions (required for the hackathon build)
# ══════════════════════════════════════════════════════════════════════════════

# ── JWT auth (ColdChain API) ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
COLDCHAIN_JWT_SECRET=

# ── Per-device HMAC secrets ────────────────────────────────────────────────────
# JSON object mapping device_id → 32-byte hex secret.
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# Example: {"fridge-A":"aabbcc...","fridge-B":"ddeeff..."}
DEVICE_SECRETS_JSON={}

# ── Telegram alerts ────────────────────────────────────────────────────────────
# Create a bot via @BotFather, then get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Demo / simulation ──────────────────────────────────────────────────────────
# Multiplier applied to heat-exposure dt (1.0 = real-time, 10.0 = 10× faster).
# Admin-only to change. Displays a visible banner on the dashboard.
DEMO_TIME_SCALE=1.0

# HMAC timestamp acceptance window in seconds (default 60).
HMAC_TS_WINDOW_S=60
